#!/usr/bin/env python3
import gi
import os
import subprocess
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

ORDER_FILE = "/usr/share/leziria-tools/leziria-tools-order.conf"
DESKTOP_DIR = "/usr/share/applications"

class LeziriaTools(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title="Lezíria Tools")
        self.set_border_width(10)

        grid = Gtk.Grid()
        grid.set_row_spacing(10)
        grid.set_column_spacing(10)
        self.add(grid)

        # Load order
        tools = []
        if os.path.exists(ORDER_FILE):
            with open(ORDER_FILE) as f:
                for line in f:
                    line = line.strip()
                    if line.endswith(".desktop"):
                        tools.append(line)

        row = 0
        for desktop_file in tools:
            desktop_path = os.path.join(DESKTOP_DIR, desktop_file)
            if not os.path.exists(desktop_path):
                continue

            name = ""
            exec_cmd = ""
            icon = ""

            with open(desktop_path) as f:
                for line in f:
                    if line.startswith("Name="):
                        name = line.split("=", 1)[1].strip()
                    if line.startswith("Exec="):
                        exec_cmd = line.split("=", 1)[1].strip()
                    if line.startswith("Icon="):
                        icon = line.split("=", 1)[1].strip()

            button = Gtk.Button(label=name)
            button.connect("clicked", self.run_tool, exec_cmd)
            grid.attach(button, 0, row, 1, 1)
            row += 1

    def run_tool(self, widget, cmd):
        subprocess.Popen(cmd.split())

win = LeziriaTools()
win.connect("destroy", Gtk.main_quit)
win.show_all()
Gtk.main()
